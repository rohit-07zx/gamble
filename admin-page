<!-- LIGHTWEIGHT REAL-TIME SCRIPT -->
<script>
    (function() {
      // Auto-compute Single Digit Modulo 10 on 3-digit Patti input
      const patti = document.getElementById('input-bazi5-patti');
      const single = document.getElementById('input-bazi5-single');

      if (patti && single) {
        patti.addEventListener('input', function(e) {
          const val = e.target.value.replace(/[^0-9]/g, '');
          e.target.value = val;
          if (val.length === 3) {
            const sum = parseInt(val[0], 10) + parseInt(val[1], 10) + parseInt(val[2], 10);
            single.value = (sum % 10).toString();
          }
        });
      }
    })();
  </script>
